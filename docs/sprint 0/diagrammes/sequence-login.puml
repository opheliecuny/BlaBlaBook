@startuml
title Diagramme de séquence — Connexion utilisateur (US-02)

actor "Utilisateur" as U
participant "Frontend\n(Next.js)" as F
participant "Rate Limiter\n(express-rate-limit)" as RL
participant "Backend API\n(Express)" as B
database "Base de données\n(PostgreSQL/Prisma)" as DB

U -> F : Remplit email + mot de passe
U -> F : Clique sur "Se connecter"

note over F
  Validation côté client (Zod)
  Format email valide
  Min. 8 caractères
  1 majuscule minimum
  1 chiffre minimum
  1 caractère spécial (!@)
end note

alt Critères non respectés
    F --> U : Affiche les critères non respectés\n(indicateur visuel par règle)
else Formulaire valide
    F -> RL : POST /api/auth/login { email, password }

    note over RL
      Vérifie le compteur de tentatives
      par IP + par email
      Fenêtre : 5 essais / 15 minutes
    end note

    alt Limite atteinte (429)
        RL --> F : 429 Too Many Requests\nRetry-After: 900 secondes
        F --> U : "Trop de tentatives. Réessayez dans 15 min."
    else Sous la limite
        RL -> B : Transmet la requête + incrémente le compteur

        note over B
          Validation côté serveur (Zod)
          2e ligne de défense
          Mêmes critères que côté client
        end note

        alt Données invalides
            B --> F : 400 Bad Request
            F --> U : Affiche l'erreur
        else Données valides
            B -> DB : SELECT * FROM users WHERE email = ?

            alt Utilisateur introuvable
                DB --> B : null
                B --> F : 401 Unauthorized — "Identifiants incorrects"
                F --> U : Affiche l'erreur
            else Utilisateur trouvé
                DB --> B : { id, email, hashedPassword, ... }

                note over B
                  bcrypt.compare(
                    password, hashedPassword
                  )
                end note

                alt Mot de passe incorrect
                    note over RL : Compteur incrémenté pour cet email
                    B --> F : 401 Unauthorized — "Identifiants incorrects"
                    F --> U : Affiche l'erreur
                else Mot de passe correct
                    note over RL : Compteur remis à zéro pour cet email
                    note over B
                      jwt.sign(
                        { userId, email },
                        SECRET,
                        { expiresIn: "24h" }
                      )
                    end note
                    B --> F : 200 OK — { token: "eyJhbGci..." }
                    note over F : Stocke le JWT\n(localStorage ou cookie)
                    F --> U : Redirection vers /library
                end
            end
        end
    end
end

@enduml
