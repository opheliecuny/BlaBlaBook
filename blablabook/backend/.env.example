PORT=XXXXX
ALLOWED_ORIGINS=XXXX
DATABASE_URL=postgresql://username:password@localhost:5433/dbname?schema=public
JWT_SECRET=XXXXX
JWT_EXPIRES_IN=1h
NODE_ENV=development
